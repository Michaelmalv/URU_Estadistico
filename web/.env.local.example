# URL del proyecto de Supabase (se encuentra en Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto-id.supabase.co

# Anon Key pública (se encuentra en Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica-aqui

# Token de acceso público de Mapbox
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=tu-token-de-mapbox-aqui
